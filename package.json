{
  "name": "ajintara",
  "version": "1.0.0",
  "description": "Mini Ajintara - Hotel Listing & Booking Platform (Single Unified Feature-Based Architecture)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "vite",
    "dev": "concurrently -k \"nodemon server.js\" \"vite\"",
    "build": "vite build",
    "seed": "node src/scripts/seed.js",
    "test": "jest --forceExit --runInBand src/tests",
    "test:concurrency": "node src/scripts/testConcurrency.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.312.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "razorpay": "^2.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.21.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.33",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.12"
